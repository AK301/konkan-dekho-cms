generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id               String   @id @default(cuid())

  name             String
  slug             String   @unique
  type             String
  location         String

  shortDescription String?
  description      String?

  rooms            Int?
  guests           Int?
  price            Int?

  phone            String?
  whatsapp         String?
  mapUrl           String?

  latitude         Float?
  longitude        Float?

  status           String   @default("DRAFT")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
